# Private EVE SSO credentials. Never commit the real .env.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_SSO_URL=https://login.eveonline.com
EVE_ESI_URL=https://esi.evetech.net/latest

# SeAT MariaDB connection; use a private account limited to fin_* tables.
FIN_DB_HOST=seat-docker-mariadb-1
FIN_DB_PORT=3306
FIN_DB_NAME=seat
FIN_DB_USER=potchven_finance
FIN_DB_PASSWORD=

# Character 1
FIN_CHAR1_NAME=
FIN_CHAR1_EVE_ID=
FIN_CHAR1_REFRESH_TOKEN=
# Character 2
FIN_CHAR2_NAME=
FIN_CHAR2_EVE_ID=
FIN_CHAR2_REFRESH_TOKEN=
# Character 3
FIN_CHAR3_NAME=
FIN_CHAR3_EVE_ID=
FIN_CHAR3_REFRESH_TOKEN=

# Corporation ID; refresh token belongs to a character with required corp roles/scopes.
FIN_CORP_NAME=
FIN_CORP_EVE_ID=
FIN_CORP_AUTH_CHARACTER_NAME=
FIN_CORP_REFRESH_TOKEN=
FIN_CORP_WALLET_DIVISION=1

# Optional: path for rotated refresh-token state; default is beside the sync script.
FIN_TOKEN_STATE_FILE=
