{
  "name": "triglavian/seat-asset-manager",
  "description": "Owner-aware cached asset management for the Triglavian Consortium SeAT installation",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Triglavian\\AssetManager\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Triglavian\\AssetManager\\AssetManagerServiceProvider"
      ]
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "orchestra/testbench": "^8.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Triglavian\\AssetManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
