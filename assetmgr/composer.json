{
  "name": "triglavian/seat-asset-manager",
  "description": "Owner-aware cached asset management for the Triglavian Consortium SeAT installation",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0",
    "illuminate/database": "^10.0",
    "illuminate/routing": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Triglavian\\AssetManager\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Triglavian\\AssetManager\\AssetManagerServiceProvider"
      ]
    }
  }
}
